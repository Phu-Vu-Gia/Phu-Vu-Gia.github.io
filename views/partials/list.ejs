<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Replace <Your Full Name> with your name here  -->
    <title>Phu Vu Gia's Weekly Readings</title>
    
    <!-- Include your favicon here -->
    <link rel="shortcut icon" href="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" type="image/x-icon">

    <!-- Styling -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Including Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
      
</head>
<body>
    <div class="container mx-auto min-vh-100 d-flex flex-column">

<!-- Header, the first section of the page-->
        <header class="d-flex align-items-center py-3">
            <img src="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" alt="logo" width="64" height="64">
            <nav class="ms-3">
                <a href="/">Home Page</a>
            </nav>
        </header>

        <!-- Main content -->
        <main class="container-fluid my-4 mx-auto flex-grow-1">

            <div class="row g-5">

                <!-- Your profile-->
                <aside id="profile" class="col-lg-4 col-md-5 d-flex flex-column justify-content-lg-start align-items-lg-start justify content-center align-items-center text-white p-5 rounded-4 shadow">
                    <div class="text-center mb-4">
                        <img src="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" alt="Profile" class="rounded-circle d-flex align-items-center justify content-center border border-4 border-white object-fit-cover">
                    </div>
                    <div class="info">
                        <div class="mb-4">
                            <span class="fs-5">Hi, I'm</span>
                            <h1>Phu Vu Gia</h1>
                        </div>
                        <div class="mt-4">
                            <h2><i>s4132254</i></h2>
                            <h2><i>s4132254@rmit.edu.vn</i></h2>
                        </div>
                    </div>
                </aside>
                
                <!-- The reading list is shown here-->
                <section id="reading-list" class="col-lg-7 d-flex flex-column justify-content-center align-items-center justify-content-lg-end align-items-lg-end">
                    <h2>Recommended <b>READING LIST</b></h2>
    
                    <form action="/" method="post" class="align-self-center align-self-lg-end mb-4">
                        <button id="btn-custom">Refresh</button>
                    </form>
    
                    <div id="book-list" class="w-100">
                        <h3 class="mt-4">Monday-Wednesday</h3>
                        <section class="list mon-to-wed mb-4">
                            <% const textbook = books.find(book => book.category === 'TEXTBOOK'); %>
                            <% if (textbook) { %>
                                <div class="book-card row g-0 overflow-hidden p-3">
                                    <div class="col-lg-6 d-flex flex-column justify-content-center">
                                        <a href="/book/<%= textbook.title %>">
                                            <h5 class="text-primary"><strong><%= textbook.title %> by <%= textbook.author %></strong></h5>
                                        </a>
                                        <p><%= textbook.description %></p>
                                        <p><%= textbook.category %></p>
                                    </div>

                                    <div class="col-lg-6 text-end">
                                        <a href="/book/<%= textbook.title %>">
                                            <img src="<%= textbook.image %>" alt="<%= textbook.title %>">
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        </section>
    
                        <h3 class="mt-4">Thursday-Friday</h3>
                        <section class="list thu-to-fri mb-4">
                            <% const philosophy = books.find(book => book.category === 'PHILOSOPHY'); %>
                            <% if (philosophy) { %>
                                <div class="book-card row g-0 overflow-hidden p-3">
                                    <div class="col-lg-6 d-flex flex-column justify-content-center">
                                        <a href="/book/<%= philosophy.title %>">
                                            <h5 class="text-primary"><strong><%= philosophy.title %> by <%= philosophy.author %></strong></h5>
                                        </a>
                                        <p><%= philosophy.description %></p>
                                        <p><%= philosophy.category %></p>
                                    </div>

                                    <div class="col-lg-6 text-end">
                                        <a href="/book/<%= philosophy.title %>">
                                            <img src="<%= philosophy.image %>" alt="<%= philosophy.title %>">
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        </section>
    
                        <h3 class="mt-4">Saturday-Sunday</h3>
                        <section class="list sat-to-sun mb-4">
                            <% const novel = books.find(book => book.category === 'NOVEL'); %>
                            <% if (novel) { %>
                                <div class="book-card row g-0 overflow-hidden p-3">
                                    <div class="col-lg-6 d-flex flex-column justify-content-center">
                                        <a href="/book/<%= novel.title %>">
                                            <h5 class="text-primary"><strong><%= novel.title %> by <%= novel.author %></strong></h5>
                                        </a>
                                        <p><%= novel.description %></p>
                                        <p><%= novel.category %></p>
                                    </div>

                                    <div class="col-lg-6 text-end">
                                        <a href="/book/<%= novel.title %>">
                                            <img src="<%= novel.image %>" alt="<%= novel.title %>">
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        </section>
                    </div>
    
                </section> 
            </div>
            
        </main>
            
        <!-- Footer -->
        <footer class="text-center py-4">
            <p>Made with👌by <strong>Phu Vu Gia</strong></p>
        </footer>
    </div>


<!-- Including Boostrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
</body>
</html>
