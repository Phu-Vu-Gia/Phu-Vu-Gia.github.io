<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Replace <Your Full Name> with your name here  -->
    <title>Phu Vu Gia's Weekly Readings</title>
    
    <!-- Include your favicon here -->
    <link rel="shortcut icon" href="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" type="image/x-icon">

    <!-- Styling -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Including Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
      
</head>
<body>
    <div class="container mx-auto min-vh-100 d-flex flex-column">

<!-- Header, the first section of the page-->
        <header>
            <img src="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" alt="logo" width="64" height="64">
            <nav>
                <a href="/">Home Page</a>
            </nav>
        </header>

        <!-- Main content -->
        <main>
            
            <!-- Your profile-->
            <aside id="profile">
                <div>
                    <img src="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" alt="" height="250" >
                </div>
                <div>
                    <div class="mb-4">
                        <span>Hi, I'm</span>
                        <h1>Phu Vu Gia</h1>
                    </div>
                    <div>
                        <h2>s4132254</h2>
                        <h2>s4132254@rmit.edu.vn</h2>
                    </div>
                </div>
            </aside>
            
            <!-- The reading list is shown here-->
            <section id="reading-list">
                <h2>Recommended <b>READING LIST</b></h2>

                <form action="/" method="post" class="align-self-center align-self-lg-end mb-4">
                    <button id="btn-custom">Refresh</button>
                </form>

                <div id="book-list">
                    <h3>Monday-Wednesday</h3>
                    <section class="list mon-to-wed">
                        <% const textbook = books.find(book => book.category === 'TEXTBOOK'); %>
                        <% if (textbook) { %>
                            <div class="book-card">
                                <img src="<%= textbook.image %>" alt="<%= textbook.title %>">
                                <p><strong><%= textbook.title %> by <%= textbook.author %></strong></p>
                                <p><%= textbook.description %></p>
                                <p><%= textbook.category %></p>
                            </div>
                        <% } %>
                    </section>

                    <h3>Thursday-Friday</h3>
                    <section class="list thu-to-fri">
                        <% const philosophy = books.find(book => book.category === 'PHILOSOPHY'); %>
                        <% if (philosophy) { %>
                            <div class="book-card">
                                <img src="<%= philosophy.image %>" alt="<%= philosophy.title %>">
                                <p><strong><%= philosophy.title %> by <%= philosophy.author %></strong></p>
                                <p><%= philosophy.description %></p>
                                <p><%= philosophy.category %></p>
                            </div>
                        <% } %>
                    </section>

                    <h3>Saturday-Sunday</h3>
                    <section class="list sat-to-sun">
                        <% const novel = books.find(book => book.category === 'NOVEL'); %>
                        <% if (novel) { %>
                            <div class="book-card">
                                <img src="<%= novel.image %>" alt="<%= novel.title %>">
                                <p><strong><%= novel.title %> by <%= novel.author %></strong></p>
                                <p><%= novel.description %></p>
                                <p><%= novel.category %></p>
                            </div>
                        <% } %>
                    </section>
                </div>

            </section> 
        </main>
            
        <!-- Footer -->
        <footer class="text-center py-4">
            <p>Made with👌by <strong>Phu Vu Gia</strong></p>
        </footer>
    </div>


<!-- Including Boostrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
</body>
</html>
