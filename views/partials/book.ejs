<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Replace <Your Full Name> with your name here  -->
    <title>Phu Vu Gia's Weekly Readings</title>
    
    <!-- Include your favicon here -->
    <link rel="shortcut icon" href="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" type="image/x-icon">

    <!-- Styling -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Including Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
      
</head>
<!-- Header-->

<body>
    <div class="container mx-auto min-vh-100 d-flex flex-column">

        <header class="d-flex align-items-center py-3">
            <img src="https://www.torredevigilancia.com/wp-content/uploads/2021/09/star-wars-knights-of-the-old-republic-kotor-will-have-1140x641.jpg" alt="logo" width="64" height="64">
            <nav class="ms-3 breadcrumbs d-flex align-items-center">
                <a href="/">Home Page</a>
                <div class="arrow mx-2"> > </div>
                <% if (displayedBook) { %>
                    <a href="javascript:window.location.reload()"><%= displayedBook.title %></a>
                <% } %>
            </nav>
        </header>

        <!-- Main content-->
        <main>
            <div class="book-details position-relative overflow-hidden rounded shadow">
                <!-- Book details-->
                <% if (displayedBook) { %>
                    <div>
                        <img src="<%= displayedBook.image %>" alt="<%= displayedBook.title %>" class="book-detail-img" width="100%">

                        <div class="book-text-overlay p-4 d-flex flex-column justify-content-start text-white">
                            <h3 class="fw-bold"><%= displayedBook.title %></h3>
                            <h4 class="mb-4">By <%= displayedBook.author %></h4>
                            <p class="description mb-4"><%= displayedBook.description %></p>
                            <p class="small fw-bold"><%= displayedBook.category %> | Published in <%= displayedBook.year %></p>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Related books in the same category -->
            <section class="related-books mt-5 position-relative">
                <h3 class="mb-4">Related Books</h3>
                
                <div class="related-list row g-4">
                    <%
                        const related = books.filter(b => b.category === displayedBook.category && b.title !== displayedBook.title);
                    %>

                    <% if (related.length > 0) { %>
                        <% related.forEach(book => { %>
                            <div class="col-md-4 col-sm-6">
                                <div class="related-item card border-0">
                                    <a href="/book/<%= book.title %>" class="text-white">
                                        <div class="image-overlay-wrapper position-relative overflow-hidden">
                                            <img src="<%= book.image %>" alt="<%= book.title %>" class="card-img-top" height="300">
                                        </div>
                                        
                                        <div class="card-body p-2 text-start">
                                            <p class="card-text ms-3 mt-3 fw-bold"><%= book.title %> By <%= book.author %></p>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-12">
                            <p class="text-muted">No other books in this category.</p>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- Back button here -->
            
            <div class="d-flex justify-content-center align-items-center mt-5">
                <button id="btn-back" onclick="window.history.back()">Back</button>
            </div>
            
        </main>
            
        <!-- Footer -->
        <footer class="text-center py-4">
            <p>Made with👌by <strong>Phu Vu Gia</strong></p>
        </footer>

    </div>

<!-- Including Boostrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>

<script>
    document.getElementById('btn-back').addEventListener('click', () => {
        window.location.href = '/'; // Redirects back to the homepage
    });
</script>
</body>
</html>
