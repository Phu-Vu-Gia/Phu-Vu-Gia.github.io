<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Replace <Your Full Name> with your name here  -->
  <title>Phu Vu Gia's Daily Meal Plan</title>

  <!-- Include your favicon here -->
  <link rel="shortcut icon" href="https://static.vecteezy.com/system/resources/previews/000/572/885/original/check-mark-icon-vector.jpg" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Including Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
  <div class="container flex-grow-1">
    <!-- Your header here -->
    <header class="d-flex align-items-center py-3">
      <img src="/images/b.png" alt="Logo" width="64" height="64">
      <nav class="breadcrumbs">
        <a href="/">Home Page</a>
        <div class="arrow">→</div>
        <% if (meal) { %>
          <a href="javascript:window.location.reload()"><%= meal.name %></a>
        <% } %>
      </nav>
    </header>

    <!-- Main content -->
    <main class="my-4">
      <% if (meal) { %>
      <div>
        <img src="<%= meal.imageUrl %>" alt="<%= meal.name %>" height="450" class="meal-detail-img">
        <section class="meal-detail-info">
          <h1>
            <%= meal.name %>
          </h1>
          <span>
            <%= meal.timeOfDay %> - <%= meal.mealType %>
          </span>
        </section>
      </div>
      <% } else { %>
      <div class="text-center my-5">
        <h1>Meal not found</h1>
      </div>
      <% } %>

      <!-- Back button here -->
      <div class="d-flex justify-content-center align-items-center mt-5">
        <button id="btn-back" onclick="window.history.back()">Back</button>
      </div>
    </main>

    <footer class="text-center py-4">
      <p>Made with👌by <strong>Phu Vu Gia</strong></p>
    </footer>
  </div>

  <!-- Including Boostrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
</body>

</html>