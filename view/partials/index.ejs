<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Replace <Your Full Name> with your name here  -->
  <title>Phu Vu Gia's Daily Meal Plan</title>
    
  <!-- Include your favicon here -->
  <link rel="shortcut icon" href="https://static.vecteezy.com/system/resources/previews/000/572/885/original/check-mark-icon-vector.jpg" type="image/x-icon">
  <link rel="stylesheet" href="style.css">

  <!-- Including Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
  <div>
    <!-- Your header here -->
    <header>
      <img src="/images/b.png" alt="Logo" width="64" height="64">
      <nav>
        <a href="/">Home Page</a>
      </nav>
    </header>

    <!-- Main content -->
    <main>
      <!-- Your profile here -->
      <aside id="profile">
        <div>
          <img src="/images/a.png" alt="Profile" height="250">
        </div>
        <div>
          <div>
            <span>Hi, I'm</span>
            <h1>Phu Vu Gia</h1>
          </div>
          <div>
            <h2>s4132254</h2>
            <h2>s4132254@rmit.edu.vn</h2>
          </div>
        </div>
      </aside>

      <!-- Your meal plan here -->
      <section id="meal-plan">
        <h1>My <b>DAILY MEAL PLAN</b></h1>

        <!-- Refresh form -->
        <form action="/" method="post">
          <button id="btn btn-submit">Refresh</button>
        </form>

        <!-- Your meal list here -->
        <div id="meal-list">
          <% meals.forEach(meal => { %>
          <div>
            <a href="/meal/<%= meal.name %>">
              <img src="<%= meal.imageUrl %>" height="300">
              <section>
                <h3>
                  <%= meal.name %>
                </h3>
                <span>
                  <%= meal.timeOfDay %> - <%= meal.mealType %>
                </span>
              </section>
            </a>
          </div>
          <% }); %>
        </div>
      </section>
    </main>

    <footer>
      Made with👌by <strong>Phu Vu Gia</strong>
    </footer>
  </div>

  <!-- Including Boostrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
</body>

</html>