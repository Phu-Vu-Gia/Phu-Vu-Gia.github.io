<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Replace <Your Full Name> with your name here  -->
  <title>Phu Vu Gia's Daily Meal Plan</title>
    
  <!-- Include your favicon here -->
  <link rel="shortcut icon" href="https://static.vecteezy.com/system/resources/previews/000/572/885/original/check-mark-icon-vector.jpg" type="image/x-icon">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Including Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
  <div class="container flex-grow-1">
    <!-- Your header here -->
    <header class="d-flex align-items-center py-3">
      <img src="/images/b.png" alt="Logo" width="64" height="64">
      <nav>
        <a href="/">Home Page</a>          
      </nav>
    </header>

    <!-- Main content with 2 columns -->
    <main class="container-fluid my-4">
      <div class="row g-4">
        <!-- Left column: Profile -->
        <aside id="profile" class="col-lg-4 col-md-5">
          <div>
            <img src="/images/a.png" alt="Profile" height="200">
          </div>
          <div>
            <div>
              <span class="fs-5">Hi, I'm</span>
              <h1>Phu Vu Gia</h1>
            </div>
            <div class="mt-4">
              <h2><i>s4132254</i></h2>
              <h2><i>s4132254@rmit.edu.vn</i></h2>
            </div>
          </div>
        </aside>

        <!-- Right column: Meal plan -->
        <section id="meal-plan" class="col-lg-7 d-flex flex-column justify-content-center align-items-center justify-content-lg-end align-items-lg-end">
          <h1>My <b>DAILY MEAL PLAN</b></h1>

          <!-- Refresh form -->
          <form action="/" method="post" class="align-self-center align-self-lg-end mb-4">
            <button id="btn-custom">Refresh</button>
          </form>

          <!-- Your meal list here -->
          <div id="meal-list">
            <% meals.forEach(meal => { %>
            <div>
              <a href="/meal/<%= meal.name %>">
                <img src="<%= meal.imageUrl %>">
                <section>
                  <h3>
                    <%= meal.name %>
                  </h3>
                  <span>
                    <%= meal.timeOfDay %> - <%= meal.mealType %>
                  </span>
                </section>
              </a>
            </div>
            <% }); %>
          </div>
        </section>
      </div>
    </main>

    <footer class="text-center py-4">
      <p>Made with👌by <strong>Phu Vu Gia</strong></p>
    </footer>
  </div>

  <!-- Including Boostrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
</body>

</html>